{
  "name": "@launchpad/server",
  "version": "1.0.0",
  "private": true,
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun --external cpu-features",
    "start": "bun run dist/index.js",

    "dev:web":      "turbo dev --filter=@launchpad/web",
    "dev:server":   "turbo dev --filter=@launchpad/server",
    "build:web":    "turbo build --filter=@launchpad/web",
  
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@elysiajs/cookie": "^0.8.0",
    "@elysiajs/cors": "^1.4.2",
    "@launchpad/shared": "workspace:*",
    "@react-email/render": "^2.0.8",
    "elysia": "^1.4.28",
    "lowdb": "^7.0.1",
    "node-ssh": "^13.2.1",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "@types/nodemailer": "^6.4.17",
    "bun-types": "^1.3.14",
    "typescript": "^5.7.2"
  }
}
